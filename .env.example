# ============================================================================
# Variables de entorno requeridas por chatbot-saas-backend
# ============================================================================
# Este archivo es plantilla — está versionado en git, SIN valores reales.
#
# Uso en local:
#   1. Copia los valores de tu setup local (no este archivo) a IntelliJ
#      Run/Debug Configurations → Environment variables (campo de texto,
#      formato KEY1=value1;KEY2=value2;...)
#   2. Run el proyecto desde IntelliJ.
#
# Uso en CI/Docker/prod:
#   Setear las mismas KEYs como env vars del proceso o vía secrets manager.
# ----------------------------------------------------------------------------
# Convención:
#   - Las KEYs sin comentario "(con default ...)" son SECRETS sin default →
#     si no las seteás, Spring no arranca.
#   - Las KEYs con default tienen un fallback razonable en `application.yml`.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=                # con default jdbc:postgresql://localhost:5432/chatbot_saas
DB_USERNAME=           # con default `postgres`
DB_PASSWORD=           # secret

# ── JPA ─────────────────────────────────────────────────────────────────────
JPA_SHOW_SQL=          # con default `false`. Setear `true` en local para ver queries.

# ── SMTP / Mail ─────────────────────────────────────────────────────────────
MAIL_HOST=             # con default smtp.gmail.com
MAIL_PORT=             # con default 587
MAIL_USERNAME=         # secret — email del remitente
MAIL_PASSWORD=         # secret — Gmail app password (NO la password normal)

# ── Frontend / CORS ─────────────────────────────────────────────────────────
APP_FRONT_URL=         # secret/config — dominio del panel (ej http://localhost:4200 o https://chat.zolvion.com)

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=            # secret — clave HMAC. Generar con `openssl rand -hex 32`.

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=           # con default 8080

# ── App-specific ────────────────────────────────────────────────────────────
PYTHON_SERVICE_URL=    # con default http://localhost:8000
INTERNAL_API_KEY=      # secret — debe coincidir con el `INTERNAL_API_KEY` del servicio Python RAG
APP_UPLOAD_DIR=        # con default `uploads`

# ── WhatsApp / Meta Cloud API ───────────────────────────────────────────────
APP_WHATSAPP_VERIFY_TOKEN=         # secret — token registrado en Meta Developers para el handshake del webhook
APP_WHATSAPP_APP_SECRET=           # secret — App Secret de Meta Developers Dashboard → Settings → Basic
APP_WHATSAPP_GRAPH_API_VERSION=    # con default v20.0

# ── Branding ────────────────────────────────────────────────────────────────
ZOLVION_ADMIN_EMAIL=   # email admin del SaaS (recibe alertas operacionales)

# ── OpenAPI / Swagger ───────────────────────────────────────────────────────
SPRINGDOC_ENABLED=     # con default `true`. Setear `false` solo en producción para ocultar Swagger UI y /v3/api-docs.
